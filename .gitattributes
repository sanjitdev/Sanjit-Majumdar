# =============================================================================
# Git attributes for Sanjit-Majumdar Portfolio / BMAD Project
# =============================================================================
# Reference: https://git-scm.com/docs/gitattributes

# -----------------------------------------------------------------------------
# Default behavior: explicitly enforce LF, normalize line endings on commit.
# This protects against CRLF creep on Windows while keeping a single canonical
# LF in the repository (core.autocrlf=input on Windows clients).
# -----------------------------------------------------------------------------
*               text=auto eol=lf

# -----------------------------------------------------------------------------
# Source code - always text, force LF
# -----------------------------------------------------------------------------

# Python
*.py            text eol=lf
*.pyi           text eol=lf
*.pyw           text eol=lf
*.pyx           text eol=lf
*.pxd           text eol=lf

# JavaScript / TypeScript
*.js            text eol=lf
*.mjs           text eol=lf
*.cjs           text eol=lf
*.jsx           text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.vue           text eol=lf
*.svelte        text eol=lf
*.json          text eol=lf
*.jsonc         text eol=lf
*.json5         text eol=lf

# Web / Styles
*.html          text eol=lf
*.htm           text eol=lf
*.css           text eol=lf
*.scss          text eol=lf
*.sass          text eol=lf
*.less          text eol=lf
*.svg           text eol=lf

# Markdown / docs (BMAD produces lots of markdown)
*.md            text eol=lf
*.mdx           text eol=lf
*.rst           text eol=lf
*.txt           text eol=lf
*.adoc          text eol=lf
*.asciidoc      text eol=lf

# Config / shell
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.ini           text eol=lf
*.cfg           text eol=lf
*.conf          text eol=lf
*.env           text eol=lf
*.env.example   text eol=lf
.editorconfig   text eol=lf

# Shell / scripts
*.sh            text eol=lf
*.bash          text eol=lf
*.zsh           text eol=lf
*.fish          text eol=lf
*.ps1           text eol=lf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Other source
*.java          text eol=lf diff=java
*.kt            text eol=lf diff=java
*.kts           text eol=lf
*.swift         text eol=lf
*.go            text eol=lf
*.rs            text eol=lf
*.c             text eol=lf
*.cc            text eol=lf
*.cpp           text eol=lf
*.cxx           text eol=lf
*.h             text eol=lf
*.hpp           text eol=lf
*.hxx           text eol=lf
*.cs            text eol=lf
*.rb            text eol=lf
*.php           text eol=lf
*.lua           text eol=lf
*.pl            text eol=lf
*.sql           text eol=lf

# -----------------------------------------------------------------------------
# Lockfiles and metadata - always LF, never converted
# -----------------------------------------------------------------------------

package-lock.json   text eol=lf
pnpm-lock.yaml      text eol=lf
yarn.lock           text eol=lf
composer.lock       text eol=lf
Gemfile.lock        text eol=lf
Pipfile.lock        text eol=lf
poetry.lock         text eol=lf
uv.lock             text eol=lf
Cargo.lock          text eol=lf
go.sum              text eol=lf

# -----------------------------------------------------------------------------
