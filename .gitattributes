# -----------------------------------------------------------------------------

# Images
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.webp            binary
*.bmp             binary
*.tiff            binary
*.tif             binary
*.psd             binary
*.ai              binary
*.eps             binary
*.heic            binary
*.avif            binary

# Fonts
*.ttf             binary
*.otf             binary
*.woff            binary
*.woff2           binary
*.eot             binary

# Media
*.mp4             binary
*.mov             binary
*.avi             binary
*.mkv             binary
*.webm            binary
*.mp3             binary
*.wav             binary
*.flac            binary
*.ogg             binary
*.m4a             binary

# Archives / executables / installers
*.zip             binary
*.tar             binary
*.gz              binary
*.bz2             binary
*.xz              binary
*.7z              binary
*.rar             binary
*.exe             binary
*.dll             binary
*.so              binary
*.dylib           binary
*.deb             binary
*.rpm             binary
*.dmg             binary
*.pkg             binary
*.msi             binary
*.iso             binary

# Documents
*.pdf             binary
*.doc             binary
*.docx            binary
*.xls             binary
*.xlsx            binary
*.ppt             binary
*.pptx            binary
*.odt             binary
*.ods             binary
*.odp             binary

# Design / 3D
*.fig             binary
*.sketch          binary
*.xd              binary
*.afdesign        binary
*.blend           binary
*.fbx             binary
*.obj             binary
