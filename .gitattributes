# -----------------------------------------------------------------------------
# Generated BMAD artifacts - HTML mockups / JSON specs often have large
# embedded blobs; keep them as text for diffability unless explicitly binary.
# -----------------------------------------------------------------------------

# BMAD UX mockups (HTML/JSON, trackable as text)
*.html           text eol=lf
_bmad-output/**  text eol=lf

# -----------------------------------------------------------------------------
# Diff drivers and language hints
# -----------------------------------------------------------------------------

# Better language detection on GitHub / gitweb
*.md             linguist-detectable=true linguist-language=Markdown
*.py             linguist-detectable=true linguist-language=Python
*.js             linguist-detectable=true linguist-language=JavaScript
*.ts             linguist-detectable=true linguist-language=TypeScript
*.html           linguist-detectable=true linguist-language=HTML
*.css            linguist-detectable=true linguist-language=CSS
*.scss           linguist-detectable=true linguist-language=Sass
*.yml            linguist-detectable=true linguist-language=YAML
*.yaml           linguist-detectable=true linguist-language=YAML
*.json           linguist-detectable=true linguist-language=JSON
*.toml           linguist-detectable=true linguist-language=TOML
*.sh             linguist-detectable=true linguist-language=Shell
*.ps1            linguist-detectable=true linguist-language=PowerShell
*.bat            linguist-detectable=true linguist-language=Batch
*.cmd            linguist-detectable=true linguist-language=Batch

# Treat these as vendored / generated (reduce noise in language stats)
docs/vendor/**           linguist-vendored
node_modules/**         linguist-vendored
_bmad/vendor/**         linguist-vendored
dist/**                 linguist-vendored
build/**                linguist-vendored
coverage/**             linguist-vendored
*.min.js                linguist-vendored
*.min.css               linguist-vendored
*-lock.json             linguist-generated
*.lock                  linguist-generated
package-lock.json       linguist-generated
yarn.lock               linguist-generated
pnpm-lock.yaml          linguist-generated

# Hide generated planning artifacts from language stats but still track them
_bmad-output/** linguist-generated

# -----------------------------------------------------------------------------
# Built-in diff drivers (require git config; commented for reference)
# -----------------------------------------------------------------------------
# [diff "python"]
#   xfuncname = "^(@@ |def |class |async def )"
#
# [diff "markdown"]
#   xfuncname = "^#{1,6} .*"
#
# To enable, add the matching *.diff=* patterns and configure git.

# Mark Python files for the python diff driver
*.py             diff=python

# -----------------------------------------------------------------------------
# Export / archive configuration
# -----------------------------------------------------------------------------

# `git archive` will not include these
.gitattributes   export-subst
.gitignore       export-subst
AGENTS.md        export-subst

# -----------------------------------------------------------------------------
# Merge strategies for lockfiles and generated files
# -----------------------------------------------------------------------------

# Auto-resolve lockfile conflicts by preferring upstream (regenerated on install)
package-lock.json     merge=union
yarn.lock             merge=union
pnpm-lock.yaml        merge=union
Cargo.lock            merge=union
go.sum                merge=union
uv.lock               merge=union

# Auto-resolve generated artifacts (regenerated by tools, not human-edited)
_bmad-output/**       merge=union
*.generated.*         merge=union

